# =====================================================================
# Sao chép file này thành `.env` (cùng thư mục backend/) rồi điền giá trị thật.
# `.env` đã bị .gitignore — KHÔNG commit mật khẩu.
# Spring đọc file này qua `spring.config.import` trong application.yml.
# =====================================================================

# ── Supabase Postgres ───────────────────────────────────────────────
# Lấy tại: Supabase Dashboard → Project Settings → Database → "Connection string".
# KHUYẾN NGHỊ dùng "Session pooler" (chạy được trên IPv4, hợp app nền + Hibernate).
#
#   Session pooler : host = aws-0-<region>.pooler.supabase.com | port 5432 | user = postgres.<project-ref>
#   Direct (IPv6)  : host = db.<project-ref>.supabase.co        | port 5432 | user = postgres
#   Tên database luôn là: postgres
#
# ⚠ Định dạng JDBC: bắt đầu bằng jdbc:postgresql:// và thêm ?sslmode=require
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# ── JPA / Hibernate ─────────────────────────────────────────────────
# dev: update (Hibernate tự tạo/cập nhật 28 bảng). prod: validate (chỉ đối chiếu).
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ── JWT (đã có default cho dev; BẮT BUỘC đổi ở prod) ─────────────────
# Chuỗi base64 đủ dài (>= 32 byte). Sinh: openssl rand -base64 48
# JWT_SECRET=

# ── Clerk (login Google cho customer) ───────────────────────────────
# Secret key: Clerk Dashboard → API Keys. CHỈ dùng ở backend, KHÔNG lộ ra client.
# Issuer/JWKS lấy từ domain instance (giải mã publishable key ra domain này).
CLERK_SECRET_KEY=sk_test_<your-clerk-secret-key>
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
CLERK_JWKS_URI=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# ── Khác (tuỳ chọn) ─────────────────────────────────────────────────
# SERVER_PORT=8080
# LOG_LEVEL=INFO
