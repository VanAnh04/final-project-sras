# =====================================================================
# Sao chép file này thành `.env` (cùng thư mục backend/) rồi điền giá trị thật.
# `.env` đã bị .gitignore — KHÔNG commit mật khẩu.
# Spring đọc file này qua `spring.config.import` trong application.yml.
# =====================================================================

# ── Supabase Postgres ───────────────────────────────────────────────
# Lấy tại: Supabase Dashboard → Project Settings → Database → "Connection string".
# KHUYẾN NGHỊ dùng "Session pooler" (chạy được trên IPv4, hợp app nền + Hibernate).
#
#   Session pooler : host = aws-0-<region>.pooler.supabase.com | port 5432 | user = postgres.<project-ref>
#   Direct (IPv6)  : host = db.<project-ref>.supabase.co        | port 5432 | user = postgres
#   Tên database luôn là: postgres
#
# ⚠ Định dạng JDBC: bắt đầu bằng jdbc:postgresql:// và thêm ?sslmode=require
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# ── JPA / Hibernate ─────────────────────────────────────────────────
# dev: update (Hibernate tự tạo/cập nhật 28 bảng). prod: validate (chỉ đối chiếu).
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ── JWT (đã có default cho dev; BẮT BUỘC đổi ở prod) ─────────────────
# Chuỗi base64 đủ dài (>= 32 byte). Sinh: openssl rand -base64 48
# JWT_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=<your-google-client-id>

# ── eSMS.vn Configuration ──────────────────────────────────────────
# ESMS_API_KEY=<your-esms-api-key>
# ESMS_SECRET_KEY=<your-esms-secret-key>
# ESMS_SMS_TYPE=2
# ESMS_BRANDNAME=Baotrixemay
# ESMS_SANDBOX=0

# ── Gmail SMTP Configuration ───────────────────────────────────────
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=<your-gmail>
# MAIL_PASSWORD=<your-app-password>

# ── Clerk (login Google cho customer) ───────────────────────────────
# Secret key: Clerk Dashboard → API Keys. CHỈ dùng ở backend, KHÔNG lộ ra client.
# Issuer/JWKS lấy từ domain instance (giải mã publishable key ra domain này).
CLERK_SECRET_KEY=sk_test_<your-clerk-secret-key>
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
CLERK_JWKS_URI=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# ── PayOS Configuration (KÊNH THU — khách thanh toán / nạp ví) ────────
# my.payos.vn → Kênh thanh toán → chọn kênh thu → Thông tin tích hợp.
# Checksum key này còn dùng để KIỂM CHỮ KÝ webhook: thiếu/sai thì mọi webhook bị bỏ qua.
# PAYOS_CLIENT_ID=<your-payos-client-id>
# PAYOS_API_KEY=<your-payos-api-key>
# PAYOS_CHECKSUM_KEY=<your-payos-checksum-key>

# /rescue-requests/{id}/pay là thanh toán GIẢ LẬP (đặt PAID mà không thu tiền).
# Dev để true cho tiện demo; PRODUCTION BẮT BUỘC false.
PAYMENT_MOCK_TRANSFER_ENABLED=true

# ── Rút tiền gara về ngân hàng (KÊNH CHI payOS — TIỀN THẬT) ──────────
# MOCK = giả lập, không chuyển tiền (STK đuôi 000 ⇒ thất bại, đuôi 999 ⇒ giả timeout).
# PAYOS = chi tiền thật qua kênh chi; thiếu 3 key bên dưới thì backend KHÔNG khởi động.
PAYOUT_PROVIDER=MOCK
# false = tắt khẩn cấp mọi lệnh rút mới (lệnh đang chạy vẫn được đối soát).
PAYOUT_ENABLED=true
# Trần tổng tiền chi của toàn hệ thống mỗi ngày (VNĐ).
PAYOUT_SYSTEM_DAILY_LIMIT=200000000

# Key RIÊNG của kênh chi (KHÁC bộ PAYOS_* của kênh thu):
# my.payos.vn → Kênh chi → chọn kênh chi (liên kết ví Bảo Kim) → Thông tin tích hợp.
# Trước khi chạy thật: nạp tiền vào tài khoản chi, TẮT duyệt lệnh tay trên dashboard,
# và khai báo IP server nếu kênh chi yêu cầu.
PAYOS_PAYOUT_CLIENT_ID=00000000-0000-0000-0000-000000000000
PAYOS_PAYOUT_API_KEY=00000000-0000-0000-0000-000000000000
PAYOS_PAYOUT_CHECKSUM_KEY=replace-with-payout-checksum-key
# Kiểm chữ ký response của kênh chi. Chỉ đặt false nếu log báo "Chữ ký response kênh chi payOS
# KHÔNG khớp" với lệnh thật và đã xác minh với payOS.
# PAYOS_PAYOUT_VERIFY_RESPONSE_SIGNATURE=true

# Khoá HMAC băm mã OTP rút tiền / đổi STK trước khi lưu DB. BẮT BUỘC khi PAYOUT_PROVIDER=PAYOS.
# Sinh: openssl rand -base64 48
ACTION_OTP_SECRET=replace-with-output-of-openssl-rand-base64-48

# Hạn mức (tuỳ chọn — mặc định như dưới):
# PAYOUT_MIN_AMOUNT=10000
# PAYOUT_MAX_AMOUNT_PER_REQUEST=20000000
# PAYOUT_MAX_AMOUNT_PER_DAY=50000000
# PAYOUT_MAX_REQUESTS_PER_DAY=5
# PAYOUT_BANK_CHANGE_LOCK_HOURS=24
# PAYOUT_FUND_LOW_THRESHOLD=5000000

# ── Gemini AI Configuration (Chẩn đoán sự cố xe thông minh) ────────
# Lấy miễn phí tại: https://aistudio.google.com/
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.0-flash

# ── Khác (tuỳ chọn) ─────────────────────────────────────────────────
# SERVER_PORT=8080
# LOG_LEVEL=INFO
