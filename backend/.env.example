# =====================================================================
# Sao chép file này thành `.env` (cùng thư mục backend/) rồi điền giá trị thật.
# `.env` đã bị .gitignore — KHÔNG commit mật khẩu.
# Spring đọc file này qua `spring.config.import` trong application.yml.
# =====================================================================

# ── Supabase Postgres ───────────────────────────────────────────────
# Lấy tại: Supabase Dashboard → Project Settings → Database → "Connection string".
# KHUYẾN NGHỊ dùng "Session pooler" (chạy được trên IPv4, hợp app nền + Hibernate).
#
#   Session pooler : host = aws-0-<region>.pooler.supabase.com | port 5432 | user = postgres.<project-ref>
#   Direct (IPv6)  : host = db.<project-ref>.supabase.co        | port 5432 | user = postgres
#   Tên database luôn là: postgres
#
# ⚠ Định dạng JDBC: bắt đầu bằng jdbc:postgresql:// và thêm ?sslmode=require
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# ── JPA / Hibernate ─────────────────────────────────────────────────
# dev: update (Hibernate tự tạo/cập nhật 28 bảng). prod: validate (chỉ đối chiếu).
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ── JWT (đã có default cho dev; BẮT BUỘC đổi ở prod) ─────────────────
# Chuỗi base64 đủ dài (>= 32 byte). Sinh: openssl rand -base64 48
# JWT_SECRET=

# ── Clerk (login Google cho customer) ───────────────────────────────
# Secret key: Clerk Dashboard → API Keys. CHỈ dùng ở backend, KHÔNG lộ ra client.
# Issuer/JWKS lấy từ domain instance (giải mã publishable key ra domain này).
CLERK_SECRET_KEY=sk_test_<your-clerk-secret-key>
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
CLERK_JWKS_URI=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json

# ── eSMS.vn (gửi OTP qua SMS) ───────────────────────────────────────
# BẮT BUỘC khi cần gửi OTP SMS — không có default trong code. Lấy tại: esms.vn → Quản lý API.
ESMS_API_KEY=<esms-api-key>
ESMS_SECRET_KEY=<esms-secret-key>
# ESMS_SMS_TYPE=2
# ESMS_BRANDNAME=Baotrixemay
# ESMS_SANDBOX=0

# ── Push notification (Expo Push Service) ───────────────────────────
# Tắt gửi push (vd khi dev không muốn bắn push thật): PUSH_ENABLED=false
# PUSH_ENABLED=true
# Chỉ cần khi bật "Enhanced Security for Push Notifications" trên expo.dev → Access tokens.
# EXPO_ACCESS_TOKEN=

# ── Gọi thoại trong app (WebRTC) ────────────────────────────────────
# Tất cả đều tuỳ chọn. Không có TURN thì vẫn gọi được khi hai máy cùng Wi-Fi; gọi 4G ↔ Wi-Fi
# (người dùng sau CGNAT) thì BẮT BUỘC có TURN — xem docs/setup.md.
# Đổ chuông quá số giây này mà không ai nghe → cuộc gọi nhỡ.
# CALL_RING_TIMEOUT_SECONDS=45
# Đang nói mà một bên mất kết nối realtime quá số giây này → cuộc gọi bị ngắt (FAILED).
# CALL_DISCONNECT_GRACE_SECONDS=20
# Chu kỳ (mili giây) server quét cuộc gọi quá hạn.
# CALL_SWEEP_INTERVAL_MS=5000
# Máy chủ STUN, phân tách bằng dấu phẩy (mặc định dùng STUN công cộng của Google).
# CALL_STUN_URLS=stun:stun.l.google.com:19302
# Máy chủ TURN để chuyển tiếp âm thanh khi hai máy không nối P2P được. Để trống = không dùng TURN.
# CALL_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# Cách 1 (khuyến nghị, coturn use-auth-secret): secret dùng chung với coturn, backend tự cấp
# credential ngắn hạn cho từng người dùng. KHÔNG commit giá trị thật.
# CALL_TURN_SECRET=
# Hạn (giây) của credential ngắn hạn ở cách 1.
# CALL_TURN_TTL_SECONDS=21600
# Cách 2: TURN dùng tài khoản cố định (chỉ áp dụng khi KHÔNG đặt CALL_TURN_SECRET).
# CALL_TURN_USERNAME=
# CALL_TURN_CREDENTIAL=

# ── Khác (tuỳ chọn) ─────────────────────────────────────────────────
# SERVER_PORT=8080
# LOG_LEVEL=INFO
