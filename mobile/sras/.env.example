# =====================================================================
# Sao chép file này thành `.env` (cùng thư mục mobile/sras/) rồi điền giá trị.
# Biến EXPO_PUBLIC_* được bundle vào app (là public) — KHÔNG đặt secret ở đây.
# =====================================================================

# ── Google OAuth Client IDs (luồng cũ, có thể bỏ nếu chỉ dùng Clerk) ──
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<web-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<android-client-id>.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<ios-client-id>.apps.googleusercontent.com

# ── Clerk — Google login cho customer ───────────────────────────────
# Publishable key: Clerk Dashboard → API Keys (pk_test_... / pk_live_...).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<your-clerk-publishable-key>

# ── Goong Maps (account.goong.io → Keys) ────────────────────────────
# API Key: routing / geocoding / place autocomplete.
# Maptiles Key: render bản đồ (goong-js / tiles). Cả 2 là public, dùng ở client.
EXPO_PUBLIC_GOONG_API_KEY=<your-goong-api-key>
EXPO_PUBLIC_GOONG_MAPTILES_KEY=<your-goong-maptiles-key>
